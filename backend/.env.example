# Copy to backend/.env for local development. Never commit the real .env.
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=https://jujiyzbnqezajuapwjbv.supabase.co
# Only if your project still uses the legacy JWT secret:
# SUPABASE_JWT_SECRET=

# Supabase → Project Settings → Database → Connection string (Session pooler).
# Replace the "postgresql://" prefix with "postgresql+psycopg://".
DATABASE_URL=

SENTRY_DSN=

# AI models — any OpenAI-compatible endpoint.
# Primary: your FreeLLMAPI gateway (rotates free providers; model "auto" lets it choose).
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=
LLM_MODEL=auto
LLM_EMBEDDING_MODEL=auto
# Backups if the gateway is down (JSON list), e.g. Groq directly:
# LLM_FALLBACKS=[{"base_url": "https://api.groq.com/openai/v1", "api_key": "...", "model": "llama-3.3-70b-versatile"}]
LLM_FALLBACKS=[]
