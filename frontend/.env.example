# Copy to .env.local and fill in. These two are PUBLIC values (safe in the browser);
# the database is protected by Supabase security rules, not by hiding them.
VITE_SUPABASE_URL=https://jujiyzbnqezajuapwjbv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the FastAPI backend lives. Leave as /api/v1 locally (Vite proxies it).
VITE_API_BASE_URL=/api/v1

# 1 = show "Explore the demo" so people can try the app without signing in.
VITE_ALLOW_GUEST=1
